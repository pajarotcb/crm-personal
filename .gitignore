# ============================================================
# .gitignore para proyecto HTML/CSS/JS puro (crm-personal)
# ============================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
desktop.ini
$RECYCLE.BIN/

# Linux
*~

# Editores e IDEs - VSCode
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (WebStorm, PhpStorm, etc.)
.idea/
*.iml
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo

# Dependencias (si en el futuro se usa npm/yarn)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Builds / carpetas de salida
dist/
build/
out/
.cache/

# Variables de entorno y secretos
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Logs
logs/
*.log

# Archivos temporales
*.tmp
*.temp
*.bak
*.backup

# Coverage
coverage/
.nyc_output/

# Herramientas
.eslintcache
.stylelintcache
.parcel-cache/

# Vercel
.vercel
